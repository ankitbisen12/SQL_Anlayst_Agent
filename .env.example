# Copy to .env and fill in. Never commit .env.

# ---------- LLM ----------
# curation / intent classification / LLM judge
LLM_MODEL_LOW=gpt-5.6-luna
# SQL generation / final answer
LLM_MODEL_MEDIUM=gpt-5.6-terra
# SQL self-correction after a failed attempt
LLM_MODEL_HIGH=gpt-5.6-sol
# second-opinion LLM safety check on top of the deterministic SQL guard
ENABLE_LLM_JUDGE=true

# ---------- Database ----------
# Supabase (Dashboard -> Connect -> Session pooler). Note the ".<project-ref>" suffix on BOTH usernames.
# URL-encode special characters in passwords (@ -> %40, : -> %3A, / -> %2F).
#   ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DATABASE_URL=postgresql://analyst_ro.<project-ref>:<ANALYST_RO_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Local Docker Postgres:
# Used by the AGENT. Must be the READ-ONLY role created by db/setup_db.py.
DATABASE_URL=postgresql://analyst_ro:change_me_ro@localhost:5432/airbnb
# Used ONLY by db/setup_db.py (schema, seed, role creation). Not needed by the running API.
ADMIN_DATABASE_URL=postgresql://airbnb_admin:change_me_admin@localhost:5432/airbnb
ANALYST_RO_USER=analyst_ro
ANALYST_RO_PASSWORD=change_me_ro
# docker-compose only: password of the Postgres superuser in the local container
POSTGRES_PASSWORD=change_me_admin

DB_STATEMENT_TIMEOUT_MS=15000
SCHEMA_CACHE_TTL_SECONDS=600

# ---------- Agent ----------
DEFAULT_ROW_LIMIT=10
MAX_ROW_LIMIT=500
MAX_SQL_RETRIES=2
SENSITIVE_COLUMNS=host_email,host_phone,email,phone,phone_number,password,password_hash,api_key,secret,token,credit_card,card_number,ssn

# ---------- API ----------
CORS_ORIGINS=http://localhost:5173
# set in production to require an X-API-Key header
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Optional: LangSmith tracing for every agent run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=airbnb-sql-analyst
